# In order to obtain an IMS_CLIENT_ID you will need to raise a support ticket with Adobe.
# Client Id's created via Adobe Developer Console will not work for Content Advisor.
VITE_IMS_CLIENT_ID=<YOUR_IMS_CLIENT_ID>
# VITE_IMS_ORG=<YOUR_IMS_ORG>

# Optional - customized Content Advisor detail panel (infoPopoverMap). Limited availability:
# only takes effect for an apiKey Adobe has enabled. See docs/content-advisor-detail-panel-customization.md
# VITE_ENABLE_DETAIL_PANEL_CUSTOMIZATION=true
# Only needed if Adobe provided an apiKey different from VITE_IMS_CLIENT_ID:
# VITE_API_KEY=<YOUR_ENABLED_API_KEY>

# Optional - customized filter panel (filterSchema, filterSchemaSource, filterSchemaDefaults).
# Available to every integration. See src/contentAdvisorFilterSchema.js
# VITE_ENABLE_FILTER_SCHEMA_CUSTOMIZATION=true
